{
  "name": "dsh-turn-retry",
  "version": "0.2.0",
  "description": "dsh plugin: restart a turn or a compaction that ended with an error, with a configurable retry budget (default 10)",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-tui",
    "turn",
    "retry"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
